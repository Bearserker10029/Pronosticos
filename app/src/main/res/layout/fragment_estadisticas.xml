<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChart"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginVertical="16dp" />

    <TextView android:id="@+id/tvAcertados" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="16sp" />
    <TextView android:id="@+id/tvFallados" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="16sp" />
    <TextView android:id="@+id/tvPendientes" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="16sp" />
</LinearLayout>